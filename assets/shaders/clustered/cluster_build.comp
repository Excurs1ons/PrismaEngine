#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

struct ClusterAABB {
    vec4 min;
    vec4 max;
};

layout(set = 0, binding = 0, std430) writeonly buffer ClusterAABBs {
    ClusterAABB clusters[];
};

layout(set = 0, binding = 1) uniform CameraData {
    mat4 projection;
    mat4 invProjection;
    mat4 view;
    float nearPlane;
    float farPlane;
    uvec2 gridSize;
    uvec2 screenSize;
    uint totalLights;
    uint numZSlices;
} camera;

vec4 screenToView(vec4 screen) {
    vec2 texCoord = screen.xy / vec2(camera.screenSize);
    vec4 clip = vec4(texCoord * 2.0 - 1.0, screen.z, screen.w);
    vec4 view = camera.invProjection * clip;
    return view / view.w;
}

vec3 intersectLinePlane(vec3 a, vec3 b, float d) {
    vec3 ab = b - a;
    float t = (d - a.z) / ab.z;
    return a + t * ab;
}

void main() {
    uvec3 clusterID = gl_GlobalInvocationID;
    if (clusterID.x >= camera.gridSize.x || clusterID.y >= camera.gridSize.y || clusterID.z >= camera.numZSlices) return;

    uint clusterIndex = clusterID.x + 
                        camera.gridSize.x * (clusterID.y + 
                        camera.gridSize.y * clusterID.z);

    vec2 tileSize = vec2(camera.screenSize) / vec2(camera.gridSize.xy);
    vec4 pMin = vec4(vec2(clusterID.xy) * tileSize, 0.0, 1.0);
    vec4 pMax = vec4(vec2(clusterID.xy + 1) * tileSize, 0.0, 1.0);

    vec3 vMin = screenToView(pMin).xyz;
    vec3 vMax = screenToView(pMax).xyz;

    float zNear = camera.nearPlane;
    float zFar = camera.farPlane;
    float sliceNear = zNear * pow(zFar / zNear, float(clusterID.z) / float(camera.numZSlices));
    float sliceFar = zNear * pow(zFar / zNear, float(clusterID.z + 1) / float(camera.numZSlices));

    vec3 eye = vec3(0.0);
    vec3 minNear = intersectLinePlane(eye, vMin, sliceNear);
    vec3 minFar  = intersectLinePlane(eye, vMin, sliceFar);
    vec3 maxNear = intersectLinePlane(eye, vMax, sliceNear);
    vec3 maxFar  = intersectLinePlane(eye, vMax, sliceFar);

    vec3 aabbMin = min(min(minNear, minFar), min(maxNear, maxFar));
    vec3 aabbMax = max(max(minNear, minFar), max(maxNear, maxFar));

    clusters[clusterIndex].min = vec4(aabbMin, 0.0);
    clusters[clusterIndex].max = vec4(aabbMax, 0.0);
}
