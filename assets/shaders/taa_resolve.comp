#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D currentFrame;
layout(binding = 1) uniform sampler2D historyFrame;
layout(binding = 2) uniform sampler2D motionVectors;  // RG: screen-space motion vectors
layout(rgba16f, binding = 3) uniform image2D outputImage;

layout(push_constant) uniform TAAParams {
    float blendFactor;     // 当前帧混合权重 (0.05-0.1)
    float jitterScale;     // 抖动缩放
    float sharpness;       // 锐化强度
    int firstFrame;        // 1 = 第一帧 (无历史)
} params;

// AABB 邻域裁剪: 将历史颜色限制在当前帧邻域的 AABB 范围内
vec3 clipAABB(vec3 historyColor, vec3 center, vec3 boxMin, vec3 boxMax) {
    // 计算到 AABB 中心的向量
    vec3 direction = historyColor - center;
    vec3 halfSize = (boxMax - boxMin) * 0.5;
    vec3 centerOffset = direction / max(halfSize, vec3(0.0001));

    // 找到最大超出比例
    float maxOffset = max(max(centerOffset.x, centerOffset.y), centerOffset.z);
    if (maxOffset > 1.0) {
        // 将历史颜色限制在 AABB 边界上
        return center + direction / maxOffset;
    }

    return historyColor;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(outputImage);

    if (coord.x >= imgSize.x || coord.y >= imgSize.y) return;

    vec2 texelSize = 1.0 / vec2(textureSize(currentFrame, 0));
    vec2 uv = (vec2(coord) + 0.5) * texelSize;

    // 当前帧颜色
    vec3 currentColor = texture(currentFrame, uv).rgb;

    // 第一帧: 直接输出
    if (params.firstFrame != 0) {
        imageStore(outputImage, coord, vec4(currentColor, 1.0));
        return;
    }

    // 采样运动向量
    vec2 motionVec = texture(motionVectors, uv).rg;

    // 使用运动向量找到历史帧的对应位置
    vec2 historyUV = uv - motionVec * params.jitterScale;

    // 边界检查: 如果超出屏幕范围, 使用当前帧
    if (historyUV.x < 0.0 || historyUV.x > 1.0 ||
        historyUV.y < 0.0 || historyUV.y > 1.0) {
        imageStore(outputImage, coord, vec4(currentColor, 1.0));
        return;
    }

    // 采样历史颜色
    vec3 historyColor = texture(historyFrame, historyUV).rgb;

    // AABB 邻域裁剪: 在 3x3 邻域内计算颜色范围
    vec3 neighborhoodMin = currentColor;
    vec3 neighborhoodMax = currentColor;

    // 采样 3x3 邻域
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            vec2 sampleUV = uv + vec2(dx, dy) * texelSize;
            vec3 sampleColor = texture(currentFrame, sampleUV).rgb;
            neighborhoodMin = min(neighborhoodMin, sampleColor);
            neighborhoodMax = max(neighborhoodMax, sampleColor);
        }
    }

    // 扩展 AABB 以防止过度裁剪 (允许一定程度的模糊)
    vec3 center = (neighborhoodMin + neighborhoodMax) * 0.5;
    vec3 halfSize = (neighborhoodMax - neighborhoodMin) * 0.5;
    vec3 clampedMin = center - halfSize * 1.25;  // 25% 扩张
    vec3 clampedMax = center + halfSize * 1.25;

    // 对历史颜色进行裁剪
    historyColor = clipAABB(historyColor, center, clampedMin, clampedMax);

    // 混合当前帧和历史帧
    float blend = params.blendFactor;
    vec3 result = mix(historyColor, currentColor, blend);

    // 可选锐化: 在高频区域增加当前帧权重
    if (params.sharpness > 0.0) {
        // 使用拉普拉斯检测边缘
        vec3 laplace = vec3(0.0);
        const float kernel[9] = float[](-1.0, -1.0, -1.0,
                                        -1.0,  8.0, -1.0,
                                        -1.0, -1.0, -1.0);
        int idx = 0;
        for (int dy = -1; dy <= 1; dy++) {
            for (int dx = -1; dx <= 1; dx++) {
                vec2 sampleUV = uv + vec2(dx, dy) * texelSize;
                vec3 sampleColor = texture(currentFrame, sampleUV).rgb;
                laplace += sampleColor * kernel[idx++];
            }
        }
        float edgeIntensity = length(laplace) * params.sharpness;
        result = mix(result, currentColor, clamp(edgeIntensity, 0.0, 1.0));
    }

    imageStore(outputImage, coord, vec4(result, 1.0));
}
