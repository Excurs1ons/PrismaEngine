#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D inputImage;   // R16_Float AO input
layout(r16f, binding = 1) uniform image2D outputImage;

layout(push_constant) uniform BlurParams {
    int height;
} params;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(outputImage);

    if (coord.x >= imgSize.x || coord.y >= imgSize.y) return;

    vec2 texelSize = 1.0 / vec2(textureSize(inputImage, 0));
    vec2 uv = (vec2(coord) + 0.5) * texelSize;

    // 5-tap Gaussian blur (vertical)
    const float weights[5] = float[](0.227027, 0.1945946, 0.1216216, 0.054054, 0.016216);
    const float offsets[5] = float[](0.0, 1.0, 2.0, 3.0, 4.0);

    float result = texture(inputImage, uv).r * weights[0];

    for (int i = 1; i < 5; i++) {
        vec2 offsetUV = vec2(0.0, offsets[i] * texelSize.y);
        result += texture(inputImage, uv + offsetUV).r * weights[i];
        result += texture(inputImage, uv - offsetUV).r * weights[i];
    }

    imageStore(outputImage, coord, vec4(result, 0.0, 0.0, 0.0));
}
