// ============================================================
// pbr_ibl_irradiance.comp - PrismaEngine PBR IBL 辐照度贴图生成
//
// 将 HDR 环境立方体贴图通过半球积分卷积为辐照度贴图。
// 用于 PBR 漫反射 IBL 光照。
//
// 输入: samplerCube environmentMap (binding 0)
// 输出: imageCube irradianceMap   (binding 1)
// ============================================================

#version 450
#extension GL_GOOGLE_include_directive : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform samplerCube environmentMap;
layout(binding = 1, rgba16f) uniform imageCube irradianceMap;

layout(push_constant) uniform PushConstants {
    float sampleDelta;  // 采样步长 (弧度), 越小质量越高
    float padding[3];
} pc;

// 将 2D 线程坐标转换为立方体贴图的方向向量
vec3 GetCubeDirection(vec2 uv, int face) {
    vec2 coord = uv * 2.0 - 1.0;
    vec3 dir = vec3(0.0);

    switch (face) {
        case 0: dir = vec3( 1.0,  coord.y, -coord.x); break; // +X
        case 1: dir = vec3(-1.0,  coord.y,  coord.x); break; // -X
        case 2: dir = vec3( coord.x,  1.0, -coord.y); break; // +Y
        case 3: dir = vec3( coord.x, -1.0,  coord.y); break; // -Y
        case 4: dir = vec3( coord.x,  coord.y,  1.0); break; // +Z
        case 5: dir = vec3(-coord.x,  coord.y, -1.0); break; // -Z
    }

    return normalize(dir);
}

void main() {
    ivec2 size = imageSize(irradianceMap);
    ivec3 pixel = ivec3(gl_GlobalInvocationID.xyz);

    // 确保不超出贴图范围
    if (pixel.x >= size.x || pixel.y >= size.y || pixel.z >= 6) return;

    // 获取当前像素对应的方向
    vec2 uv = (vec2(pixel.xy) + 0.5) / vec2(size);
    vec3 N = GetCubeDirection(uv, pixel.z);

    // 半球积分 (采用黎曼和)
    vec3 irradiance = vec3(0.0);
    float sampleDelta = pc.sampleDelta > 0.0 ? pc.sampleDelta : 0.025;

    int numSamples = 0;
    for (float phi = 0.0; phi < 2.0 * 3.14159265; phi += sampleDelta) {
        for (float theta = 0.0; theta < 0.5 * 3.14159265; theta += sampleDelta) {
            // 球面坐标到笛卡尔坐标
            vec3 tangentSample = vec3(
                sin(theta) * cos(phi),
                sin(theta) * sin(phi),
                cos(theta)
            );

            // 从切线空间到世界空间
            vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
            vec3 right = normalize(cross(up, N));
            up = cross(N, right);

            vec3 sampleDir = normalize(
                right * tangentSample.x + up * tangentSample.y + N * tangentSample.z
            );

            irradiance += texture(environmentMap, sampleDir).rgb * cos(theta) * sin(theta);
            numSamples++;
        }
    }

    if (numSamples > 0) {
        irradiance = 3.14159265 * irradiance / float(numSamples);
    }

    imageStore(irradianceMap, pixel, vec4(irradiance, 1.0));
}
