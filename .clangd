# Clangd configuration for PrismaEngine.
#
# On Linux: compile_commands.json is produced by CMake + Ninja with GCC-style
#   flags. clangd auto-detects the compiler from compile_commands.json (clang++),
#   which properly finds C++ standard library headers (libstdc++).
#   The Remove rules below are largely no-ops (GCC flags don't match).
#
# On Windows: CMake + Visual Studio produces MSVC-style compile_commands.json.
#   clangd auto-detects clang-cl from compile_commands.json, which natively
#   understands MSVC-style flags (/MDd, /Zi, /Fo, etc.).
#
# Remove rules strip only flags that are unnecessary for clangd (response
# files, output paths, warnings, etc.). The compiler driver handles the rest.

CompileFlags:
  Remove:
    # CMake external wrapping
    - "-external:*"
    - "/external:*"
    # MSVC response files (@file.modmap)
    - "@*"
    # MSVC output/PDB flags (clangd doesn't need them)
    - "-Fo*"
    - "-Fd*"
    - "-Fe*"
    # MSVC preprocessor/permissive flags
    - "-Zc:*"
    - "/Zc:*"
    - "-permissive-"
    - "/permissive-"
    # MSVC warning-control flags
    - "-W4"
    - "/W4"
    - "-W3"
    - "/W3"
    - "-wd*"
    - "/wd*"
    - "-we*"
    - "/we*"
    - "-WX"
    - "/WX"
    # MSVC sync-PDB flag
    - "-FS"
    - "/FS"

  Add:
    # ===== C++ standard =====
    - "-std=c++23"
    # ===== Preprocessor defines =====
    - "-DNOMINMAX"
    - "-DWIN32_LEAN_AND_MEAN"
    - "-D_DISABLE_CONSTEXPR_MUTEX_CONSTRUCTOR"
    - "-DENGINE_BUILD_SHARED=1"
    - "-DENGINE_EXPORTS=1"
    - "-DPRISMA_ENABLE_RENDER_VULKAN=1"
    - "-DPRISMA_ENABLE_AUDIO_SDL3=1"
    - "-DPRISMA_ENABLE_SCRIPTING=2"
    - "-DPRISMA_ENABLE_MCP=1"
    - "-DPRISMA_ENGINE_EXPORTS=1"
    - "-DPRISMA_HAS_GLSLANG=1"
    - "-DTINYXML2_DEBUG"
    # ===== Engine include paths =====
    - "-I./src"
    - "-I./src/engine"
    - "-I./src/engine/core"
    - "-I./src/engine/math"
    - "-I./src/engine/graphic"
    - "-I./src/engine/graphic/interfaces"
    - "-I./src/engine/graphic/adapters"
    - "-I./src/engine/graphic/pipelines"
    - "-I./src/engine/graphic/upscaler"
    - "-I./src/engine/audio"
    - "-I./src/engine/audio/dsp"
    - "-I./src/engine/resource"
    - "-I./src/engine/tilemap"
    - "-I./src/engine/tilemap/core"
    - "-I./src/engine/tilemap/format"
    - "-I./src/engine/tilemap/renderer"
    - "-I./src/engine/input"
    - "-I./src/engine/input/drivers"
    - "-I./src/engine/ui"
    - "-I./src/engine/ui/2d"
    - "-I./src/engine/scripting"
    - "-I./src/engine/platform"
    - "-I./src/engine/packing"
    - "-I./src/engine/scene"
    - "-I./src/engine/app"
    - "-I./src/engine/logger"
    - "-I./src/engine/physics"
    - "-I./src/engine/config"
    - "-I./src/engine/serialization"
    - "-I./src/engine/threading"
    - "-I./src/engine/transform"
    - "-I./src/engine/utils"
    - "-I./src/engine/window"
    - "-I./src/engine/object"
    - "-I./src/engine/mcp"
    - "-I./src/projects"
    # ===== Third-party dependency includes =====
    - "-I./.dependencies/glm-src"
    - "-I./.dependencies/stb-src"
    - "-I./.dependencies/glaze-src/include"
    - "-I./.dependencies/tinyxml2-src/include"
    - "-I./.dependencies/zstd-src/lib"
    - "-I./.dependencies/zstd-src/lib/common"
    - "-I./.dependencies/vma-src/include"
    - "-I./.dependencies/Vulkan-Headers-src/include"
    - "-I./.dependencies/Vulkan-Headers-src/include/vulkan"
    - "-I./.dependencies/vk-bootstrap-src/include"
    - "-I./.dependencies/vk-bootstrap-src/src"
    - "-I./.dependencies/SDL3-src/include"
    - "-I./.dependencies/SDL3-src/include/SDL3"
    - "-I./.dependencies/DirectX-Headers-src/include"
    - "-I./.dependencies/imgui-src"
    - "-I./.dependencies/imgui-src/backends"
    - "-I./.dependencies/nlohmann_json-src/include"
    - "-I./.dependencies/spirv-reflect-src"
    - "-I./.dependencies/xxhash-src"
    # ===== Build-generated headers =====
    - "-I./build/windows-x64-debug/_deps/SDL3-build/include-revision"
    - "-I./build/windows-x64-debug/_deps/SDL3-build/include-config-debug/build_config"

Index:
  Background: Build
