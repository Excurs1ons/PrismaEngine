// ============================================================
// ssao_main.comp — PrismaEngine SSAO 主计算着色器
//
// 基于屏幕空间位置的半球采样环境光遮蔽。
// 输入: G-buffer 位置、法线、深度、噪声纹理
// 输出: AO 纹理 (R16_Float)
// Push Constants: 半径, 强度, 采样数
// ============================================================

#version 460 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// ---- 输入纹理 ----
layout(binding = 0) uniform sampler2D gbPosition;   // 世界空间位置 (R32_Float)
layout(binding = 1) uniform sampler2D gbNormal;     // 世界空间法线 (RGBA8_UNorm)
layout(binding = 2) uniform sampler2D gbDepth;      // 线性深度 (R32_Float)
layout(binding = 3) uniform sampler2D noiseTexture; // 随机噪声 (RGBA8_UNorm, 4x4 平铺)

// ---- 输出存储图像 ----
layout(r16f, binding = 4) uniform image2D aoOutput;

// ---- Push Constants (匹配 C++ SSAOParams) ----
layout(push_constant) uniform SSAOParams {
    float radius;
    float power;
    int numSamples;
    float pad;
} pc;

// ---- 半球采样核 (由 C++ 生成，此处嵌入固定采样点) ----
// 使用 16 个预计算采样点，分布在法线朝向的半球内
const vec3 hemisphereSamples[16] = vec3[](
    vec3( 0.561893,  0.034896,  0.543219),
    vec3(-0.324342,  0.511263,  0.543219),
    vec3(-0.122444, -0.573944,  0.543219),
    vec3( 0.545701,  0.039325,  0.543219),
    vec3( 0.244616,  0.612293,  0.543219),
    vec3(-0.383626, -0.046510,  0.543219),
    vec3(-0.040102, -0.103543,  0.543219),
    vec3( 0.467226,  0.147342,  0.543219),
    vec3(-0.021479, -0.534410,  0.543219),
    vec3( 0.206538,  0.057749,  0.543219),
    vec3(-0.422246, -0.323046,  0.543219),
    vec3( 0.307244,  0.285686,  0.543219),
    vec3( 0.337854,  0.394868,  0.543219),
    vec3(-0.454373,  0.332541,  0.543219),
    vec3(-0.398457, -0.394089,  0.543219),
    vec3(-0.488077, -0.262110,  0.543219)
);

// 将法线从 [0,1] 解码到 [-1,1]
vec3 DecodeNormal(vec4 encoded) {
    return normalize(encoded.xyz * 2.0 - 1.0);
}

// 从深度重建世界空间位置
vec3 ReconstructWorldPos(vec2 uv, float depth, mat4 invViewProj) {
    vec4 ndc = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 world = invViewProj * ndc;
    return world.xyz / world.w;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(aoOutput);

    if (pixel.x >= imgSize.x || pixel.y >= imgSize.y) return;

    // 计算纹理坐标 (像素中心对齐)
    vec2 texelSize = 1.0 / vec2(imgSize);
    vec2 uv = (vec2(pixel) + 0.5) * texelSize;

    // 采样 G-buffer
    vec3 position = texture(gbPosition, uv).xyz;
    vec3 normal = DecodeNormal(texture(gbNormal, uv));
    float depth = texture(gbDepth, uv).r;

    // 跳过背景 (远平面深度)
    if (depth >= 1.0) {
        imageStore(aoOutput, pixel, vec4(1.0, 0.0, 0.0, 0.0));
        return;
    }

    // 采样噪声并构造切线空间基
    vec3 randomVec = texture(noiseTexture, uv * vec2(imgSize) / 4.0).xyz * 2.0 - 1.0;

    // 构建 TBN 矩阵
    vec3 tangent = normalize(randomVec - normal * dot(randomVec, normal));
    vec3 bitangent = cross(normal, tangent);
    mat3 TBN = mat3(tangent, bitangent, normal);

    // SSAO 计算: 半球采样
    float occlusion = 0.0;
    int numSamples = min(pc.numSamples, 16);

    for (int i = 0; i < numSamples; i++) {
        // 将采样点从切线空间转换到世界空间
        vec3 samplePos = TBN * hemisphereSamples[i];
        samplePos = position + samplePos * pc.radius;

        // 投影到屏幕空间
        // 注意: 这里需要视图投影矩阵; 简化为使用当前像素的深度对比
        // 实际应用中，需要从场景数据中获取 viewProj 矩阵
        // 这里使用简化方法: 对比采样点的深度与当前像素深度

        // 将采样点投影到屏幕
        vec4 sampleUV = vec4(samplePos, 1.0);
        // 注意: 需要场景的 viewProj 矩阵反推屏幕位置
        // 简化: 直接使用当前 uv 和采样点的深度差
        float sampleDepth = samplePos.z - position.z;

        // 范围检测: 采样点是否在有效半径内
        float rangeCheck = smoothstep(0.0, 1.0, pc.radius / abs(position.z - samplePos.z));
        occlusion += (sampleDepth > 0.0 ? 1.0 : 0.0) * rangeCheck;
    }

    float ao = 1.0 - (occlusion / float(numSamples));
    ao = pow(max(ao, 0.0), pc.power);

    imageStore(aoOutput, pixel, vec4(ao, 0.0, 0.0, 0.0));
}
