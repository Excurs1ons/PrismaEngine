// ============================================================
// pbr_ibl_irradiance.comp — PrismaEngine IBL 漫反射辐照度计算着色器
//
// 从 HDR 环境立方体贴图生成漫反射辐照度贴图。
// 对每个纹素，在半球内均匀采样并积分。
// 输出: 辐照度立方体贴图 (每个 face 为一层)
// Push Constants: 采样步长
// ============================================================

#version 460 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// ---- 输入环境贴图 ----
layout(binding = 0) uniform samplerCube environmentMap;

// ---- 输出辐照度贴图 (存储图像, 每 dispatch 一个 face) ----
layout(rgba16f, binding = 1) uniform imageCube irradianceOutput;

// ---- Push Constants (匹配 C++ struct { float sampleDelta; float padding[3]; }) ----
layout(push_constant) uniform IrradianceParams {
    float sampleDelta;      // 采样步长 (弧度)
    float padding0;
    float padding1;
    float padding2;
} pc;

const float PI = 3.14159265359;

// 将立方体贴图的 face 索引和纹理坐标转换为采样方向
vec3 GetCubeDirection(ivec2 coord, ivec2 size, int face) {
    vec2 uv = (vec2(coord) + 0.5) / vec2(size) * 2.0 - 1.0;

    switch (face) {
        case 0: return vec3( 1.0,  uv.y, -uv.x); // +X
        case 1: return vec3(-1.0,  uv.y,  uv.x); // -X
        case 2: return vec3( uv.x,  1.0, -uv.y); // +Y
        case 3: return vec3( uv.x, -1.0,  uv.y); // -Y
        case 4: return vec3( uv.x,  uv.y,  1.0); // +Z
        case 5: return vec3(-uv.x,  uv.y, -1.0); // -Z
    }
    return vec3(0.0);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(irradianceOutput);

    if (coord.x >= imgSize.x || coord.y >= imgSize.y) return;

    int face = int(gl_GlobalInvocationID.z);
    if (face >= 6) return;

    // 获取采样方向
    vec3 N = normalize(GetCubeDirection(coord, imgSize, face));
    vec3 up = vec3(0.0, 1.0, 0.0);
    vec3 right = normalize(cross(up, N));
    up = normalize(cross(N, right));

    vec3 irradiance = vec3(0.0);
    float totalWeight = 0.0;

    float sampleDelta = max(pc.sampleDelta, 0.001);

    // 在半球内均匀采样
    int numSamplesPhi = int(2.0 * PI / sampleDelta);
    int numSamplesTheta = int(0.5 * PI / sampleDelta);

    for (int phiIdx = 0; phiIdx < numSamplesPhi; phiIdx++) {
        for (int thetaIdx = 0; thetaIdx < numSamplesTheta; thetaIdx++) {
            float phi = (float(phiIdx) + 0.5) * sampleDelta;
            float theta = (float(thetaIdx) + 0.5) * sampleDelta;

            // 球面坐标到笛卡尔坐标 (切线空间)
            vec3 tangentSample = vec3(
                sin(theta) * cos(phi),
                sin(theta) * sin(phi),
                cos(theta)
            );

            // 切线空间到世界空间
            vec3 sampleDir = tangentSample.x * right +
                             tangentSample.y * up +
                             tangentSample.z * N;

            irradiance += texture(environmentMap, sampleDir).rgb * cos(theta) * sin(theta);
            totalWeight += cos(theta) * sin(theta);
        }
    }

    irradiance = PI * irradiance / max(totalWeight, 0.0001);

    imageStore(irradianceOutput, coord, vec4(irradiance, 1.0));
}
