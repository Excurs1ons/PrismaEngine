// ============================================================
// ssao_blur_h.comp — PrismaEngine SSAO 水平模糊计算着色器
//
// 5x1 高斯核水平方向模糊，分离式双边滤波。
// 输入: AO 纹理 (R16_Float)
// 输出: 临时模糊纹理 (R16_Float)
// Push Constants: 图像宽度 (用于边界处理)
// ============================================================

#version 460 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// ---- 输入 AO 纹理 ----
layout(binding = 0) uniform sampler2D aoInput;

// ---- 输出临时模糊纹理 ----
layout(r16f, binding = 1) uniform image2D blurOutput;

// ---- Push Constants (匹配 C++ struct { uint32_t width; }) ----
layout(push_constant) uniform BlurParams {
    uint width;
} params;

// 5x1 高斯核权重
const float kernelWeights[5] = float[](0.153388, 0.221461, 0.250301, 0.221461, 0.153388);
const int kernelHalf = 2;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(blurOutput);

    if (coord.x >= imgSize.x || coord.y >= imgSize.y) return;

    vec2 texelSize = 1.0 / vec2(imgSize);
    vec2 uv = (vec2(coord) + 0.5) * texelSize;

    // 中心像素的 AO 值 (用于双边权重的分母)
    float centerAO = texture(aoInput, uv).r;
    const float bilateralSigma = 0.1;

    float result = 0.0;
    float totalWeight = 0.0;

    for (int i = -kernelHalf; i <= kernelHalf; i++) {
        vec2 sampleUV = uv + vec2(float(i) * texelSize.x, 0.0);
        float sampleAO = texture(aoInput, sampleUV).r;

        // 双边权重: 空间高斯 * 值域高斯
        float spatialWeight = kernelWeights[i + kernelHalf];
        float rangeWeight = exp(-abs(sampleAO - centerAO) / bilateralSigma);

        float weight = spatialWeight * rangeWeight;
        result += sampleAO * weight;
        totalWeight += weight;
    }

    result /= max(totalWeight, 0.0001);

    imageStore(blurOutput, coord, vec4(result, 0.0, 0.0, 0.0));
}
