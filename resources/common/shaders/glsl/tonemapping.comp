// ============================================================
// tonemapping.comp — PrismaEngine ACES Filmic Tonemapping
//
// Full-screen compute pass for HDR→LDR conversion.
// Uses ACES filmic tone mapping + optional gamma correction.
// Push Constants: exposure, gamma
// ============================================================

#version 460 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// ---- Input ----
layout(binding = 0) uniform sampler2D inputTexture;   // HDR scene color (RGBA16F)

// ---- Output ----
layout(rgba16f, binding = 1) uniform image2D outputImage;

// ---- Push constants ----
layout(push_constant) uniform TonemapParams {
    float exposure;
    float gamma;
} pc;

// ---- ACES filmic tone mapping (Narkowicz 2015 fit) ----
vec3 ACESFilm(vec3 x) {
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

// ---- Reinhard (fallback) ----
vec3 ReinhardToneMap(vec3 color) {
    return color / (color + vec3(1.0));
}

// ---- Gamma correction ----
vec3 ApplyGamma(vec3 color, float gamma) {
    return pow(max(color, vec3(0.0)), vec3(1.0 / gamma));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(outputImage);

    if (pixel.x >= imgSize.x || pixel.y >= imgSize.y) return;

    vec2 texelSize = 1.0 / vec2(imgSize);
    vec2 uv = (vec2(pixel) + 0.5) * texelSize;

    // Sample HDR color
    vec3 hdrColor = texture(inputTexture, uv).rgb;

    // Apply exposure
    hdrColor *= pc.exposure;

    // ACES filmic tone mapping
    vec3 ldrColor = ACESFilm(hdrColor);

    // Optional: Reinhard fallback for very bright pixels (blend)
    // Using pure ACES for all pixels

    // Apply gamma correction
    ldrColor = ApplyGamma(ldrColor, pc.gamma);

    // Output LDR color
    imageStore(outputImage, pixel, vec4(ldrColor, 1.0));
}
