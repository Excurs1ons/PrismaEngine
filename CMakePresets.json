{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "host=x64",
      "cacheVariables": {
        "PRISMA_USE_FETCHCONTENT": "ON",
        "PRISMA_BUILD_ENGINE": "ON",
        "PRISMA_BUILD_EDITOR": "ON",
        "PRISMA_BUILD_LAUNCHER": "ON",
        "PRISMA_ENABLE_IMGUI_DEBUG": "ON",
        "PRISMA_ENABLE_RENDER_VULKAN": "ON",
        "PRISMA_ENABLE_RENDER_DX12": "OFF",
        "PRISMA_ENABLE_AUDIO_XAUDIO2": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/windows-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PRISMA_BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/windows-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PRISMA_BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "android-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Android",
        "PRISMA_USE_FETCHCONTENT": "ON",
        "PRISMA_BUILD_ENGINE": "ON",
        "PRISMA_BUILD_LAUNCHER": "ON",
        "PRISMA_BUILD_EDITOR": "OFF",
        "PRISMA_ENABLE_RENDER_VULKAN": "ON",
        "PRISMA_ENABLE_RENDER_DX12": "OFF",
        "PRISMA_ENABLE_AUDIO_XAUDIO2": "OFF",
        "PRISMA_USE_NATIVE_INPUT": "OFF",
        "PRISMA_USE_NATIVE_AUDIO": "OFF",
        "CMAKE_FIND_PACKAGE_PREFER_CONFIG": "OFF",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_NDK": "$env{ANDROID_NDK_HOME}/",
        "ANDROID_PLATFORM": "android-34",
        "CMAKE_ANDROID_STL_TYPE": "c++_shared"
      }
    },
    {
      "name": "android-arm64-debug",
      "displayName": "Android arm64 Debug",
      "inherits": "android-base",
      "binaryDir": "${sourceDir}/build/android-arm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ANDROID_ABI": "arm64-v8a"
      }
    },
    {
      "name": "android-arm64-release",
      "displayName": "Android arm64 Release",
      "inherits": "android-base",
      "binaryDir": "${sourceDir}/build/android-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "PRISMA_USE_FETCHCONTENT": "ON",
        "PRISMA_BUILD_ENGINE": "ON",
        "PRISMA_BUILD_EDITOR": "ON",
        "PRISMA_BUILD_LAUNCHER": "ON",
        "PRISMA_ENABLE_IMGUI_DEBUG": "ON",
        "PRISMA_ENABLE_RENDER_VULKAN": "ON",
        "PRISMA_ENABLE_RENDER_OPENGL": "OFF",
        "PRISMA_ENABLE_AUDIO_SDL3": "ON",
        "PRISMA_ENABLE_INPUT_SDL3": "ON",
        "PRISMA_USE_NATIVE_AUDIO": "OFF",
        "PRISMA_USE_NATIVE_INPUT": "OFF",
        "PRISMA_ENABLE_UPSCALER_FSR": "OFF",
        "PRISMA_ENABLE_UPSCALER_DLSS": "OFF",
        "PRISMA_ENABLE_UPSCALER_TSR": "OFF",
        "PRISMA_ENABLE_SCRIPTING": "OFF"
      }
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x64 Debug",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/linux-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PRISMA_BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x64 Release",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/linux-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PRISMA_BUILD_SHARED_LIBS": "OFF"
      }
    },
    {
      "name": "linux-arm64-base",
      "hidden": true,
      "inherits": "linux-base",
      "cacheVariables": {
        "PRISMA_BUILD_LAUNCHER": "ON",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_C_COMPILER": "aarch64-linux-gnu-gcc",
        "CMAKE_CXX_COMPILER": "aarch64-linux-gnu-g++"
      }
    },
    {
      "name": "linux-arm64-debug",
      "displayName": "Linux ARM64 Debug",
      "inherits": "linux-arm64-base",
      "binaryDir": "${sourceDir}/build/linux-arm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PRISMA_BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "linux-arm64-release",
      "displayName": "Linux ARM64 Release",
      "inherits": "linux-arm64-base",
      "binaryDir": "${sourceDir}/build/linux-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PRISMA_BUILD_SHARED_LIBS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "targets": ["Engine", "PrismaCore", "PrismaGenerators", "Prisma2D"],
      "configuration": "Debug",
      "jobs": 32
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "targets": ["Engine", "PrismaCore", "PrismaGenerators", "Prisma2D"],
      "configuration": "Release",
      "jobs": 32
    },
    {
      "name": "android-arm64-debug",
      "configurePreset": "android-arm64-debug",
      "jobs": 2
    },
    {
      "name": "android-arm64-release",
      "configurePreset": "android-arm64-release",
      "jobs": 2
    },
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64-debug",
      "jobs": 2
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64-release",
      "jobs": 2
    },
    {
      "name": "linux-arm64-debug",
      "configurePreset": "linux-arm64-debug",
      "jobs": 2
    },
    {
      "name": "linux-arm64-release",
      "configurePreset": "linux-arm64-release",
      "jobs": 2
    }
  ]
}
