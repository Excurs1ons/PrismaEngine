#version 460
#extension GL_EXT_ray_query : enable

// ============================================================================
// mlgi_probe_update.comp — Probe irradiance update using GL_EXT_ray_query
//
// Traces rays from each probe position using hardware-accelerated ray queries,
// projects the observed radiance onto spherical harmonics (SH order 0-2, 9
// coefficients), and writes the result to the probe SH output buffer.
//
// ── Workgroup ──
//   layout(local_size_x = 8, local_size_y = 4, local_size_z = 1)
//   Total: 32 threads per workgroup.
//   Each workgroup handles one probe; each thread traces one ray direction.
//
// ── Ray Budget ──
//   Default: 32 rays per probe (matches workgroup size).
//   Configurable via raysPerProbe uniform (clamped to 32).
//   Max trace distance configurable via maxTraceDist uniform.
//   Total rays per frame = probeCount * raysPerProbe.
//   Example: 4×2×4 grid × 32 rays = 128 × 32 = 4096 rays/frame.
//
// ── Ray Flags ──
//   gl_RayFlagsOpaqueEXT | gl_RayFlagsSkipClosestHitShaderEXT
//   - Opaque: skip alpha-test geometry (not needed for probe visibility)
//   - SkipClosestHit: we only need hit info, not full closest-hit shading
//
// ── SH Output Layout ──
//   coefficients[probeIndex * 9 + coeffIndex] = vec4(R, G, B, 1.0)
//   Coeff order: L0, L1-1, L10, L11, L2-2, L2-1, L20, L21, L22
//   (standard real spherical harmonics, order 0 then 1 then 2)
//
// ── Radiance Model (MVP) ──
//   - Hit emissive surface → emissive radiance (albedo * emissive)
//   - Hit diffuse surface → albedo (simple diffuse shading)
//   - Miss / beyond maxDist → skyColor uniform (environment fallback)
//   Upgrade path: replace traceProbeRay() with full material evaluation.
//
// ── Sample Source ──
//   Deterministic 2D samples from SampleSource CPU class.
//   Hemisphere sampling matches probe_samples.glsl conventions.
//   See: projects/MLGIPipeline/assets/shaders/probe_samples.glsl
// ============================================================================

layout(local_size_x = 8, local_size_y = 4, local_size_z = 1) in;

// ── Constants ──
const float PI = 3.14159265359;
const float EPS = 0.001;

// ── Probe Grid UBO (std140) ──
layout(std140, binding = 0) uniform ProbeGridUBO {
    vec3  gridOrigin;       // world-space origin of the grid (minimum corner)
    float probeSpacing;     // distance between adjacent probes (world units)
    ivec3 gridDim;          // probes per dimension (x, y, z)
    int   raysPerProbe;     // number of rays per probe (default 32, max 32)
    float maxTraceDist;     // maximum ray trace distance (world units)
    vec3  skyColor;         // fallback radiance for ray misses / sky
    float _pad0;
} probeGrid;

// ── Probe Samples SSBO (std430, readonly) ──
// Deterministic 2D samples generated by SampleSource CPU class.
// Layout matches probe_samples.glsl convention (16-byte header + vec2[]).
layout(std430, binding = 1) readonly buffer ProbeSamplesBlock {
    uint  sampleCount;      // total number of pre-generated samples
    uint  seed;             // seed used for generation (debug/QA)
    uint  mode;             // 0=Halton, 1=Hammersley
    uint  _pad;             // padding (16-byte header alignment)
    vec2  samples[];        // sample positions in [0,1]^2
} probeSamples;

// ── TLAS (hardware acceleration structure) ──
// Built by the engine from all scene geometry (mesh + non-mesh).
layout(binding = 2) uniform accelerationStructureEXT tlas;

// ── Scene Objects SSBO (std430, readonly) ──
// Used for hit shading: object color + emissive lookup.
struct SceneObject {
    vec4 p0;            // type in .w: 0=plane, 1=sphere, 2=box, 3=cone, 4=mesh
    vec4 p1;
    vec4 p2;
    vec4 color;         // .rgb = albedo, .w = emissive intensity
    mat4 worldMatrix;
    mat4 invWorldMatrix;
};

layout(std430, binding = 3) readonly buffer SceneData {
    int objectCount;
    SceneObject objects[];
} scene;

// ── Probe SH Output SSBO (std430, write) ──
// SH9 coefficients per probe, stored as vec4 (RGB in .xyz, w = 1.0).
// Layout: coefficients[probeIndex * 9 + coeffIndex]
// Coeff order: L0, L1-1, L10, L11, L2-2, L2-1, L20, L21, L22
layout(std430, binding = 4) buffer ProbeSHOutput {
    vec4 coefficients[];
} probeSH;

// ── Shared memory for SH accumulation ──
// 32 threads × 9 SH bands × 3 color channels = 864 floats (~3.4 KB)
// Well within the typical 16-48 KB shared memory limit.
// Each thread writes to its own slot (no conflicts), then thread 0 reduces.
shared float shSlot[864];

// ============================================================================
// Deterministic sample helpers
// (matching probe_samples.glsl — see that file for CPU-side counterpart)
// ============================================================================

// Get a 2D probe sample by index (wraps via modulo for safety)
vec2 getProbeSample(uint index) {
    uint idx = index % probeSamples.sampleCount;
    return probeSamples.samples[idx];
}

// Convert a 2D uniform sample [0,1]^2 to a cosine-weighted hemisphere
// direction around the given normal.
vec3 sampleHemisphere(vec2 u, vec3 normal) {
    float r = sqrt(u.x);
    float theta = 6.283185307 * u.y;

    // Build orthonormal basis (tangent, bitangent, normal)
    vec3 tangent = abs(normal.y) < 0.9999
        ? vec3(0.0, 1.0, 0.0)
        : vec3(1.0, 0.0, 0.0);
    vec3 bitangent = normalize(cross(normal, tangent));
    tangent = cross(bitangent, normal);

    return tangent * r * cos(theta)
         + bitangent * r * sin(theta)
         + normal * sqrt(max(0.0, 1.0 - u.x));
}

// Convenience: get a probe ray direction directly from sample index + normal
vec3 getProbeRayDir(uint sampleIndex, vec3 normal) {
    vec2 u = getProbeSample(sampleIndex);
    return sampleHemisphere(u, normal);
}

// ============================================================================
// Real spherical harmonics basis evaluation (order 0-2, 9 coefficients)
//
// Uses standard real SH basis functions:
//   L0:  Y00
//   L1:  Y1-1, Y10, Y11
//   L2:  Y2-2, Y2-1, Y20, Y21, Y22
//
// Reference: https://en.wikipedia.org/wiki/Spherical_harmonics#Real_form
// ============================================================================
void evalSHBasis(vec3 dir, out float sh[9]) {
    // L0 — DC term (constant)
    sh[0] = 0.2820947918; // 1/(2*sqrt(pi))

    // L1 — linear gradients
    sh[1] = -0.4886025119 * dir.y; // -sqrt(3/(4*pi)) * y
    sh[2] =  0.4886025119 * dir.z; //  sqrt(3/(4*pi)) * z
    sh[3] = -0.4886025119 * dir.x; // -sqrt(3/(4*pi)) * x

    // L2 — quadratic
    sh[4] =  1.0925484306 * dir.x * dir.y;                         //  sqrt(15/(4*pi)) * xy
    sh[5] = -1.0925484306 * dir.y * dir.z;                         // -sqrt(15/(4*pi)) * yz
    sh[6] =  0.3153915653 * (3.0 * dir.z * dir.z - 1.0);          //  0.5*sqrt(5/(4*pi)) * (3z²-1)
    sh[7] = -1.0925484306 * dir.x * dir.z;                         // -sqrt(15/(4*pi)) * xz
    sh[8] =  0.5462742153 * (dir.x * dir.x - dir.y * dir.y);      //  0.5*sqrt(15/(4*pi)) * (x²-y²)
}

// ============================================================================
// Trace a single probe ray and return observed radiance
//
// Visibility-only logic: we use ray query to determine whether the ray hits
// geometry, then return a simple radiance value based on the hit object's
// properties. No full material evaluation (MVP simplification).
//
// Upgrade path: replace this function with a full path tracing loop for
// multi-bounce indirect illumination.
// ============================================================================
vec3 traceProbeRay(vec3 origin, vec3 dir) {
    rayQueryEXT rq;

    // Initialize ray query:
    //   - gl_RayFlagsOpaqueEXT: only intersect opaque geometry
    //   - gl_RayFlagsSkipClosestHitShaderEXT: skip closest-hit shader
    //     (we only need hit info, not full closest-hit shading)
    //   - cullMask = 0xFF: intersect all geometry instances
    //   - tMin = EPS: small offset to avoid self-intersection
    //   - tMax = maxTraceDist: configurable max trace distance
    rayQueryInitializeEXT(rq, tlas,
        gl_RayFlagsOpaqueEXT | gl_RayFlagsSkipClosestHitShaderEXT,
        0xFF, origin, EPS, dir, probeGrid.maxTraceDist);

    // Proceed the ray query (synchronous in compute shader context)
    rayQueryProceedEXT(rq);

    // Check for a committed intersection
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionEXT) {
        float hitT = rayQueryGetIntersectionTEXT(rq, true);

        // If hit is beyond max distance, treat as miss → sky
        if (hitT >= probeGrid.maxTraceDist - EPS) {
            return probeGrid.skyColor;
        }

        // Get instance custom index → maps to scene object index
        int objIndex = int(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true));

        // Look up object color for simple shading
        if (objIndex >= 0 && objIndex < scene.objectCount) {
            SceneObject obj = scene.objects[objIndex];
            vec3 albedo = obj.color.rgb;
            float emissive = obj.color.w;

            // Emissive surface → use emissive radiance
            // Diffuse surface → use albedo (simple diffuse shading)
            if (emissive > 0.0) {
                return albedo * emissive;
            } else {
                return albedo;
            }
        }
    }

    // Miss or invalid hit: use sky/environment fallback
    return probeGrid.skyColor;
}

// ============================================================================
// Main entry point
//
// Dispatch dimensions:
//   gl_NumWorkGroups.x = probeCount (total probes in grid)
//   gl_NumWorkGroups.y = 1
//   gl_NumWorkGroups.z = 1
// ============================================================================
void main() {
    uint probeIndex = gl_WorkGroupID.x;
    uint rayIndex   = gl_LocalInvocationIndex; // 0..31

    // ── Early out: invalid probe index or zero rays ──
    uint totalProbes = uint(probeGrid.gridDim.x) *
                       uint(probeGrid.gridDim.y) *
                       uint(probeGrid.gridDim.z);
    if (probeIndex >= totalProbes) return;
    if (probeGrid.raysPerProbe <= 0) return;

    // Clamp active rays to workgroup size (32 max)
    uint activeRays = min(uint(probeGrid.raysPerProbe), 32u);

    // ── Step 1: Compute probe world position from grid index ──
    // Linear index → 3D grid coordinates (row-major: x fastest, then y, then z)
    uint totalX  = uint(probeGrid.gridDim.x);
    uint totalXY = totalX * uint(probeGrid.gridDim.y);
    uint pz = probeIndex / totalXY;
    uint rem = probeIndex % totalXY;
    uint py = rem / totalX;
    uint px = rem % totalX;

    vec3 probePos = probeGrid.gridOrigin +
                    vec3(float(px), float(py), float(pz)) * probeGrid.probeSpacing;

    // ── Step 2: Trace ray and accumulate SH contribution ──
    // MVP: use upward normal for hemisphere sampling.
    // Upgrade path: replace with full-sphere sampling or normal-aware sampling.
    vec3 upNormal = vec3(0.0, 1.0, 0.0);

    // Initialize shared memory slot for this thread
    int slotBase = int(rayIndex) * 9;

    if (rayIndex < activeRays) {
        // Get deterministic ray direction from sample source
        vec3 rayDir = getProbeRayDir(rayIndex, upNormal);

        // Trace the ray and get observed radiance
        vec3 radiance = traceProbeRay(probePos, rayDir);

        // Evaluate SH basis for this ray direction
        float sh[9];
        evalSHBasis(rayDir, sh);

        // Write radiance * SH basis to thread-local shared memory slot
        for (int i = 0; i < 9; i++) {
            int baseIdx = (slotBase + i) * 3;
            shSlot[baseIdx + 0] = radiance.r * sh[i];
            shSlot[baseIdx + 1] = radiance.g * sh[i];
            shSlot[baseIdx + 2] = radiance.b * sh[i];
        }
    } else {
        // Inactive threads write zeros (ensures clean reduction)
        for (int i = 0; i < 9; i++) {
            int baseIdx = (slotBase + i) * 3;
            shSlot[baseIdx + 0] = 0.0;
            shSlot[baseIdx + 1] = 0.0;
            shSlot[baseIdx + 2] = 0.0;
        }
    }

    barrier();

    // ── Step 3: Thread 0 reduces all contributions and writes SH output ──
    if (rayIndex == 0u) {
        float invN = 1.0 / float(activeRays);

        for (int b = 0; b < 9; b++) {
            float sumR = 0.0, sumG = 0.0, sumB = 0.0;

            // Sum contributions from all active threads
            for (uint t = 0; t < activeRays; t++) {
                int base = (int(t) * 9 + b) * 3;
                sumR += shSlot[base + 0];
                sumG += shSlot[base + 1];
                sumB += shSlot[base + 2];
            }

            // Write averaged SH coefficient to output buffer
            uint outIdx = probeIndex * 9u + uint(b);
            probeSH.coefficients[outIdx] = vec4(
                sumR * invN,
                sumG * invN,
                sumB * invN,
                1.0
            );
        }
    }
}
