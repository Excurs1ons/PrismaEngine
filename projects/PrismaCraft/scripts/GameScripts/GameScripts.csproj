<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PrismaCraft_Managed</AssemblyName>
    <RootNamespace>GameScripts</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- 纯类库：自包含发布由 PrismaEngine.Host 负责 -->
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/engine/scripting/CSharp/Prisma.Core/Prisma.Core.csproj">
      <Private>true</Private>
    </ProjectReference>
    <ProjectReference Include="../../../../src/engine/scripting/CSharp/Prisma.Generators/Prisma.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <TrimmerRootAssembly Include="PrismaCraft_Managed" />
  </ItemGroup>
</Project>
