<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>NeoEditor</RootNamespace>
    <AssemblyName>NeoEditor</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSDKVersion)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="WinUI.Dock" Version="2.2.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2730-prerelease" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="NeoEditor.Core\NeoEditor.Core.csproj" />
  </ItemGroup>

  <Target Name="CopyAssets" AfterTargets="Build">
    <ItemGroup>
      <WebUIAssets Include="assets\webui\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebUIAssets)" DestinationFolder="$(OutputPath)\assets\webui\%(RecursiveDir)" />
  </Target>
</Project>
