{
    // 项目名称（HUD 左上角显示）
    "name": "PathTracing3D（3D路径追踪模板）",

    // 入口场景（相对 assets/ 搜索路径）
    "entryScene": "scenes/math_wonderland.scene.json",

    // 可选多场景列表（F6 下一场景 F7 上一场景）
    "scenes": [
        "scenes/math_wonderland.scene.json",
        "scenes/cornell_box.scene.json"
    ],

    // 窗口配置
    "window": {
        "size": {
            "width": 1280,
            "height": 720
        },
        "fullscreen": false,
        "resizable": true,
        "vsync": "Mailbox",  // Immediate / Mailbox / Adaptive / VSync
        "maxFPS": 0          // 0 为无限制
    },

    // 渲染模式
    "renderMode": "PathTracing",

    // ========== 渲染配置 ==========
    "rendering": {
        "pathTracing": {
            "maxSamples": 1024,  // 最大采样帧数（收敛后停止累积）
            "maxBounces": 16,    // 光线最大弹射次数

            "rtMode": "HardwareRT",       // 光线追踪模式: None / RayQuery / HardwareRT

            // 路径追踪模式（PathTraceMode 枚举）:
            //   0 = Flat       — 暴力遍历所有三角形（兼容性好）
            //   1 = BVH        — BVH 加速遍历（默认，性能更佳）
            //   2 = HardwareRT — Vulkan 硬件光线追踪（需 RTX 显卡）
            //   3 = RayQuery  — 计算着色器 + VK_KHR_ray_query（Vulkan 1.3+，不需要 RTX 核心）
            "pathTraceMode": "BVH",

            "enableNEE": false   // 下一事件估计（小光源场景显著提升收敛速度）
        },
        "renderer2D": {
            "maxBatchQuads": 10000,
            "pixelPerfect": true,
            "crtEffect": false
        }
    },

    // 脚本后端: Off / Mono / CoreCLR
    "scriptingBackend": "CoreCLR",

    // 启用的子系统白名单
    "subsystems": ["Audio", "ScriptEngine"],

    // 额外的资产搜索路径
    "assets": [
        "assets",
        "projects/PathTracing3D/assets"
    ],

    // ========== 无头渲染配置（CLI --headless） ==========
    "headless": {
        "frames": 500,      // 渲染帧数
        "width": 1080,       // 输出宽度
        "height": 1080,      // 输出高度
        "outputPath": "pt_output.png"  // 输出文件路径
    }
}
