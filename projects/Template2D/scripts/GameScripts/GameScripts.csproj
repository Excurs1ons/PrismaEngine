<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>GameScripts</AssemblyName>
    <RootNamespace>GameScripts</RootNamespace>
    <Nullable>enable</Nullable>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <OutputType>Exe</OutputType>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>link</TrimMode>
    <!-- 逃逸舱：C++ CoreCLRHost 从原生代码调用 C#，修剪器默认关闭此功能 -->
    <_EnableConsumingManagedCodeFromNativeHosting>true</_EnableConsumingManagedCodeFromNativeHosting>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../src/engine/scripting/CSharp/Prisma.Core/Prisma.Core.csproj">
      <Private>true</Private>
    </ProjectReference>
    <ProjectReference Include="../../../../src/engine/scripting/CSharp/Prisma.Generators/Prisma.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- 保留从原生代码（C++ CoreCLRHost）调用的入口点，防止 linker 删除 -->
    <TrimmerRootAssembly Include="GameScripts" />
  </ItemGroup>

  <!--
    自包含发布需要 OutputType=Exe → 编译器要求 Main() 入口点。
    但实际入口由 C++ CoreCLRHost 通过 UnmanagedCallersOnly 触发，
    此 Main() 永远不会被调用。
    通过 MSBuild 在 obj/ 下自动生成，不污染源码树。
  -->
  <Target Name="GenerateStubEntryPoint" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_StubProgram>$(IntermediateOutputPath)GeneratedProgram.cs</_StubProgram>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(_StubProgram)"
      Lines="// &lt;auto-generated/&gt;&#10;// 存根入口点。实际入口由 C++ CoreCLRHost 通过 load_assembly_and_get_function_pointer 触发。&#10;class Program { static void Main() {} }"
      Overwrite="true"
      Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(_StubProgram)" />
    </ItemGroup>
  </Target>
</Project>
