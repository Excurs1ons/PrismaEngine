{
    "name": "MetroidvaniaDemo",
    "window": {
        "size": {
            "width": 1280,
            "height": 720
        },
        "vsync": "Mailbox",
        "resizable": true,
        "fullscreen": false,
        "maxFPS": 0
    },
    "rendering": {
        "pathTracing": {
            "maxSamples": 1,
            "maxBounces": 4,
            "rtMode": "None",
            "pathTraceMode": "Flat",
            "enableNEE": false
        },
        "renderer2D": {
            "maxBatchQuads": 1024,
            "pixelPerfect": false,
            "crtEffect": false
        }
    },
    "renderMode": "2D",
    "subsystems": ["Physics"],
    "scriptingBackend": "CoreCLR",
    "entryScene": "assets/scenes/main.scene.json",
    "assets": [
        "assets",
        "projects/MetroidvaniaDemo/assets"
    ],
    "scenes": []
}
