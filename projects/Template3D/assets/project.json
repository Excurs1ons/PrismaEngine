{
    "name": "Template3D（3D路径追踪模板）",
    "entryScene": "scenes/cornell_box.scene.json",
    "assets": ["assets", "projects/Template3D/assets"],
    "window": {
        "width": 1280,
        "height": 720,
        "fullscreen": false,
        "resizable": true,
        "vsync": "Mailbox",
        "maxFPS": 0
    },
    "rendering": {
        "maxSamples": 1024,
        "maxBounces": 16,
        "pathTraceMode": "Flat",
        "enableNEE": false
    },
    "headless": {
        "frames": 500,
        "width": 1080,
        "height": 1080,
        "outputPath": "pt_output.png"
    },
    "renderMode": "PathTracing"
}
