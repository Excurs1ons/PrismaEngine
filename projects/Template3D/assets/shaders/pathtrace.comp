#version 460

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) uniform image2D outputImage;
layout(rgba16f, binding = 1) uniform image2D accumImage;

// Camera UBO (std140)
layout(std140, binding = 2) uniform CameraUBO {
    vec4 cameraPos;
    vec4 cameraDir;
    vec4 cameraUp;
    vec4 cameraRight;
    float fov;
    float aspectRatio;
    int frameCount;
    int maxBounces;
    int samplesPerPixel;
    int useAccumulation;
    int resetAccumulation;
    int enableNEE;
} ubo;

// Scene objects SSBO
struct SceneObject {
    vec4 p0;    // type=0(plane): point; type=1(sphere): center; type=2(box): center; type=3(cone): center
    vec4 p1;    // plane: normal; sphere: (r,0,0,0); box: (hx,hy,hz,0); cone: (radius,halfHeight,0,0)
    vec4 p2;    // plane: (umin,vmin,umax,vmax); box/cone: (cosA,sinA,0,0); sphere: unused
    vec4 color; // rgb + emissive in w
    mat4 worldMatrix;    // 世界矩阵
    mat4 invWorldMatrix; // 逆矩阵（用于 local space tracing）
};

layout(std430, binding = 3) readonly buffer SceneData {
    int objectCount;
    SceneObject objects[];
} scene;

struct Vertex {
    vec3 pos;
    float pad0;
    vec3 nrm;
    float pad1;
};

struct Triangle {
    Vertex vertices[3];
};

layout(std430, binding = 4) readonly buffer TriangleBuffer {
    int triangleCount;
    Triangle triangles[];
} triBuf;

layout(std430, binding = 5) buffer DummyBVH { int dummy; } dummyBvh;
layout(std430, binding = 6) buffer DummyTriToObject { int dummy; } dummyTriToObj;

uint randState;

const float EPS = 0.005; // 稍微增大偏移量

uint wangHash(uint seed) {
    seed = (seed ^ 61u) ^ (seed >> 16u);
    seed *= 9u;
    seed = seed ^ (seed >> 4u);
    seed *= 0x27d4eb2du;
    seed = seed ^ (seed >> 15u);
    return seed;
}

float randFloat() {
    randState = randState * 747796405u + 2891336453u;
    uint result = randState >> 16u;
    return float(result) / 65535.0;
}

struct HitResult {
    float t;
    vec3 normal;
    vec3 color;
    float emissive;
    int objIndex;
};

// ============ Intersection Functions ============
bool intersectPlane(vec3 origin, vec3 dir, SceneObject obj, out HitResult hit) {
    vec3 point = obj.p0.xyz, normal = obj.p1.xyz;
    vec4 bounds = obj.p2;
    float denom = dot(dir, normal);
    if (abs(denom) < 1e-8) return false;
    float t = dot(point - origin, normal) / denom;
    if (t < EPS) return false;
    vec3 pt = origin + t * dir;
    vec3 an = abs(normal);
    bool valid = (an.x > 0.5) ? (pt.y >= bounds.x && pt.y <= bounds.z && pt.z >= bounds.y && pt.z <= bounds.w) :
                 (an.y > 0.5) ? (pt.x >= bounds.x && pt.x <= bounds.z && pt.z >= bounds.y && pt.z <= bounds.w) :
                                (pt.x >= bounds.x && pt.x <= bounds.z && pt.y >= bounds.y && pt.y <= bounds.w);
    if (!valid) return false;
    hit.t = t; hit.normal = (denom < 0.0) ? normal : -normal;
    hit.color = obj.color.rgb; hit.emissive = obj.color.w; return true;
}

bool intersectSphere(vec3 origin, vec3 dir, SceneObject obj, out HitResult hit) {
    vec3 oc = origin - obj.p0.xyz;
    float a = dot(dir, dir), b = 2.0 * dot(oc, dir), c = dot(oc, oc) - obj.p1.x * obj.p1.x;
    float disc = b * b - 4.0 * a * c;
    if (disc < 0.0) return false;
    float t = (-b - sqrt(disc)) / (2.0 * a);
    if (t < EPS) t = (-b + sqrt(disc)) / (2.0 * a);
    if (t < EPS) return false;
    hit.t = t; hit.normal = normalize((origin + t * dir) - obj.p0.xyz);
    hit.color = obj.color.rgb; hit.emissive = 0.0; return true;
}

bool intersectTriangle(vec3 origin, vec3 dir, vec3 v0, vec3 v1, vec3 v2, vec3 n0, vec3 n1, vec3 n2, out HitResult hit) {
    vec3 e1 = v1 - v0, e2 = v2 - v0, p = cross(dir, e2);
    float det = dot(e1, p);
    if (abs(det) < 1e-10) return false;
    float invDet = 1.0 / det;
    vec3 tVec = origin - v0;
    float u = dot(tVec, p) * invDet;
    if (u < 0.0 || u > 1.0) return false;
    vec3 q = cross(tVec, e1);
    float v = dot(dir, q) * invDet;
    if (v < 0.0 || u + v > 1.0) return false;
    float t = dot(e2, q) * invDet;
    if (t < EPS) return false;
    // 先插值，检查退化（法线全零或极小），然后用面法线回退，最后归一化
    vec3 interpN = (1.0 - u - v) * n0 + u * n1 + v * n2;
    if (dot(interpN, interpN) < 0.1) interpN = cross(e1, e2);
    vec3 n = normalize(interpN);
    hit.t = t; hit.normal = (dot(dir, n) < 0.0) ? n : -n; return true;
}

bool traceScene(vec3 origin, vec3 dir, int skipIndex, out HitResult hit) {
    hit.t = 1e30; hit.objIndex = -1; bool found = false;
    for (int i = 0; i < scene.objectCount; i++) {
        if (i == skipIndex) continue;
        SceneObject obj = scene.objects[i];
        HitResult r; bool hitObj = false; int type = int(obj.p0.w);
        if (type == 0) hitObj = intersectPlane(origin, dir, obj, r);
        else if (type == 1) hitObj = intersectSphere(origin, dir, obj, r);
        else if (type == 4) {
            int firstTri = int(obj.p1.x), triCount = int(obj.p1.y);
            vec3 lo = (obj.invWorldMatrix * vec4(origin, 1.0)).xyz;
            vec3 ldR = (obj.invWorldMatrix * vec4(dir, 0.0)).xyz;
            float ds = length(ldR); vec3 ld = ldR / ds;
            for (int ti = 0; ti < triCount; ti++) {
                int idx = firstTri + ti;
                if (intersectTriangle(lo, ld, triBuf.triangles[idx].vertices[0].pos, triBuf.triangles[idx].vertices[1].pos, triBuf.triangles[idx].vertices[2].pos, triBuf.triangles[idx].vertices[0].nrm, triBuf.triangles[idx].vertices[1].nrm, triBuf.triangles[idx].vertices[2].nrm, r)) {
                    float wt = r.t / ds;
                    if (wt < hit.t) {
                        r.t = wt; r.color = obj.color.rgb; r.emissive = obj.color.w;
                        r.normal = normalize((obj.worldMatrix * vec4(r.normal, 0.0)).xyz);
                        hit = r; hit.objIndex = i; found = true;
                    }
                }
            }
            continue;
        }
        if (hitObj && r.t < hit.t) { hit = r; hit.objIndex = i; found = true; }
    }
    return found;
}

float traceShadow(vec3 origin, vec3 dir, float maxT, int skipIndex1, int skipIndex2) {
    for (int i = 0; i < scene.objectCount; i++) {
        if (i == skipIndex1 || i == skipIndex2) continue;
        SceneObject obj = scene.objects[i];
        int type = int(obj.p0.w); HitResult r;
        if (type == 0) { if (intersectPlane(origin, dir, obj, r) && r.t < maxT - EPS) return 0.0; }
        else if (type == 1) { if (intersectSphere(origin, dir, obj, r) && r.t < maxT - EPS) return 0.0; }
        else if (type == 4) {
            int firstTri = int(obj.p1.x), triCount = int(obj.p1.y);
            vec3 lo = (obj.invWorldMatrix * vec4(origin, 1.0)).xyz;
            vec3 ldR = (obj.invWorldMatrix * vec4(dir, 0.0)).xyz;
            float ds = length(ldR); vec3 ld = ldR / ds; float lt = maxT * ds;
            for (int ti = 0; ti < triCount; ti++) {
                if (intersectTriangle(lo, ld, triBuf.triangles[firstTri + ti].vertices[0].pos, triBuf.triangles[firstTri + ti].vertices[1].pos, triBuf.triangles[firstTri + ti].vertices[2].pos, triBuf.triangles[firstTri + ti].vertices[0].nrm, triBuf.triangles[firstTri + ti].vertices[1].nrm, triBuf.triangles[firstTri + ti].vertices[2].nrm, r)) {
                    if (r.t < lt - EPS) return 0.0;
                }
            }
        }
    }
    return 1.0;
}

vec3 sampleLightPoint(SceneObject obj, out vec3 normal, out float pdf) {
    if (int(obj.p0.w) == 4) {
        int firstTri = int(obj.p1.x), triCount = int(obj.p1.y);
        int ti = clamp(firstTri + int(randFloat() * float(triCount)), firstTri, firstTri + triCount - 1);
        Triangle tri = triBuf.triangles[ti];
        vec3 v0 = tri.vertices[0].pos, v1 = tri.vertices[1].pos, v2 = tri.vertices[2].pos;
        float u = randFloat(), v = randFloat(); if (u + v > 1.0) { u = 1.0 - u; v = 1.0 - v; }
        vec3 lp = v0 + u * (v1 - v0) + v * (v2 - v0);
        normal = normalize((obj.worldMatrix * vec4(normalize(cross(v1-v0, v2-v0)), 0.0)).xyz);
        vec3 we1 = (obj.worldMatrix * vec4(v1-v0, 0.0)).xyz, we2 = (obj.worldMatrix * vec4(v2-v0, 0.0)).xyz;
        pdf = 1.0 / (0.5 * length(cross(we1, we2)) * float(triCount) + 1e-6);
        return (obj.worldMatrix * vec4(lp, 1.0)).xyz;
    }
    vec4 b = obj.p2; float u = b.x + randFloat() * (b.z - b.x), v = b.y + randFloat() * (b.w - b.y);
    vec3 an = abs(obj.p1.xyz);
    normal = obj.p1.xyz; pdf = 1.0 / ((b.z - b.x) * (b.w - b.y) + 1e-6);
    return (an.x > 0.5) ? vec3(obj.p0.x, u, v) : (an.y > 0.5) ? vec3(u, obj.p0.y, v) : vec3(u, v, obj.p0.z);
}

vec3 tracePath(vec3 origin, vec3 dir, int lightIndex) {
    vec3 radiance = vec3(0.0), throughput = vec3(1.0);
    for (int bounce = 0; bounce < ubo.maxBounces; bounce++) {
        HitResult hit;
        if (!traceScene(origin, dir, -1, hit)) break;
        vec3 hitPos = origin + hit.t * dir;
        if (hit.emissive > 0.0) {
            // 调试用：无论是否开启 NEE，都添加灯光直接命中（会偏亮但能证明可见性）
            radiance += throughput * hit.color * hit.emissive;
            break;
        }
        if (ubo.enableNEE != 0 && lightIndex >= 0) {
            SceneObject lObj = scene.objects[lightIndex]; vec3 lNormal; float lPdf;
            vec3 lPt = sampleLightPoint(lObj, lNormal, lPdf);
            vec3 toL = lPt - hitPos; float d2 = dot(toL, toL), d = sqrt(d2); vec3 lDir = toL / d;
            float cosH = max(dot(lDir, hit.normal), 0.0);
            float cosL = abs(dot(lDir, lNormal)); // 强制灯光双面采样
            if (cosH > 0.0 && cosL > 0.0 && lPdf > 0.0 && d2 > 0.0001) {
                float vis = traceShadow(hitPos + hit.normal * EPS, lDir, d, hit.objIndex, lightIndex);
                if (vis > 0.0) radiance += min(throughput * lObj.color.rgb * lObj.color.w * hit.color * cosH * cosL * vis / (3.14159265 * d2 * lPdf), vec3(2.0));
            }
        }
        vec3 u1 = abs(hit.normal.y) < 0.999 ? vec3(0,1,0) : vec3(1,0,0);
        vec3 tangent = normalize(cross(hit.normal, u1)), bitangent = cross(hit.normal, tangent);
        float r1 = randFloat(), r2 = randFloat(), r = sqrt(r1), phi = 6.2831853 * r2;
        vec3 nextDir = tangent * r * cos(phi) + bitangent * r * sin(phi) + hit.normal * sqrt(max(0.0, 1.0 - r1));
        throughput *= hit.color;
        if (bounce > 5) {
            float s = max(throughput.r, max(throughput.g, throughput.b));
            if (randFloat() > s) break; throughput /= s;
        }
        origin = hitPos + hit.normal * EPS; dir = nextDir;
    }
    return radiance;
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy), size = imageSize(outputImage);
    if (any(greaterThanEqual(pix, size))) return;
    int lIdx = -1;
    for (int i = 0; i < scene.objectCount; i++) { if (scene.objects[i].color.w > 0.0) { lIdx = i; break; } }
    randState = wangHash(uint(pix.x + pix.y * size.x) + uint(ubo.frameCount * 1234567u));
    float hFov = tan(ubo.fov * 0.5), aF = hFov * ubo.aspectRatio;
    float px = ((float(pix.x) + randFloat()) / float(size.x) * 2.0 - 1.0) * aF;
    float py = -((float(pix.y) + randFloat()) / float(size.y) * 2.0 - 1.0) * hFov;
    vec3 rd = normalize(ubo.cameraDir.xyz + px * ubo.cameraRight.xyz + py * ubo.cameraUp.xyz);
    vec3 rad = tracePath(ubo.cameraPos.xyz, rd, lIdx);
    if (ubo.useAccumulation > 0 && ubo.resetAccumulation == 0 && ubo.frameCount > 0) rad = mix(imageLoad(accumImage, pix).rgb, rad, 1.0 / float(ubo.frameCount + 1));
    imageStore(accumImage, pix, vec4(rad, 1.0)); imageStore(outputImage, pix, vec4(rad, 1.0));
}
