#version 460

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba32f, binding = 0) uniform image2D outputImage;
layout(rgba32f, binding = 1) uniform image2D accumImage;

// Camera UBO (std140)
layout(std140, binding = 2) uniform CameraUBO {
    vec4 cameraPos;
    vec4 cameraDir;
    vec4 cameraUp;
    vec4 cameraRight;
    float fov;
    float aspectRatio;
    int frameCount;
    int maxBounces;
    int samplesPerPixel;
    int useAccumulation;
    int resetAccumulation;
    int enableNEE;
} ubo;

// Scene objects SSBO
struct SceneObject {
    vec4 p0;    // type=0(plane): point; type=1(sphere): center; type=2(box): center
    vec4 p1;    // plane: normal; sphere: (r,0,0,0); box: (hx,hy,hz,0)
    vec4 p2;    // plane: (umin,vmin,umax,vmax); box: (cosA,sinA,0,0); sphere: unused
    vec4 color; // rgb + emissive in w
};

layout(std430, binding = 3) readonly buffer SceneData {
    int objectCount;
    SceneObject objects[];
} scene;

uint randState;

uint wangHash(uint seed) {
    seed = (seed ^ 61u) ^ (seed >> 16u);
    seed *= 9u;
    seed = seed ^ (seed >> 4u);
    seed *= 0x27d4eb2du;
    seed = seed ^ (seed >> 15u);
    return seed;
}

float randFloat() {
    randState = randState * 747796405u + 2891336453u;
    uint result = randState >> 16u;
    return float(result) / 65535.0;
}

struct HitResult {
    float t;
    vec3 normal;
    vec3 color;
    float emissive;
    int objIndex;
};

// ============ Plane intersection (type=0) ============
bool intersectPlane(vec3 origin, vec3 dir, SceneObject obj, out HitResult hit) {
    vec3 point = obj.p0.xyz;
    vec3 normal = obj.p1.xyz;
    vec4 bounds = obj.p2;

    float denom = dot(dir, normal);
    if (abs(denom) < 1e-8) return false;
    float t = dot(point - origin, normal) / denom;
    if (t < 0.001) return false;

    vec3 pt = origin + t * dir;

    vec3 an = abs(normal);
    bool valid = false;
    if (an.x > 0.5) {
        valid = pt.y >= bounds.x && pt.y <= bounds.z &&
                pt.z >= bounds.y && pt.z <= bounds.w;
    } else if (an.y > 0.5) {
        valid = pt.x >= bounds.x && pt.x <= bounds.z &&
                pt.z >= bounds.y && pt.z <= bounds.w;
    } else {
        valid = pt.x >= bounds.x && pt.x <= bounds.z &&
                pt.y >= bounds.y && pt.y <= bounds.w;
    }
    if (!valid) return false;

    hit.t = t;
    hit.normal = normal;
    hit.color = obj.color.rgb;
    hit.emissive = obj.color.w;
    return true;
}

// ============ Sphere intersection (type=1) ============
bool intersectSphere(vec3 origin, vec3 dir, SceneObject obj, out HitResult hit) {
    vec3 center = obj.p0.xyz;
    float radius = obj.p1.x;

    vec3 oc = origin - center;
    float a = dot(dir, dir);
    float b = 2.0 * dot(oc, dir);
    float c = dot(oc, oc) - radius * radius;
    float disc = b * b - 4.0 * a * c;
    if (disc < 0.0) return false;

    float sqrtDisc = sqrt(disc);
    float t = (-b - sqrtDisc) / (2.0 * a);
    if (t < 0.001) {
        t = (-b + sqrtDisc) / (2.0 * a);
        if (t < 0.001) return false;
    }

    vec3 pt = origin + t * dir;
    hit.t = t;
    hit.normal = normalize(pt - center);
    hit.color = obj.color.rgb;
    hit.emissive = 0.0;
    return true;
}

// ============ Box intersection (type=2, with Y-axis rotation) ============
bool intersectBox(vec3 origin, vec3 dir, SceneObject obj, out HitResult hit) {
    vec3 center = obj.p0.xyz;
    vec3 hs = obj.p1.xyz;
    float cosA = obj.p2.x;
    float sinA = obj.p2.y;

    vec3 rel = origin - center;
    vec3 lo = vec3(
        rel.x * cosA - rel.z * sinA, rel.y, rel.x * sinA + rel.z * cosA);
    vec3 ld = vec3(
        dir.x * cosA - dir.z * sinA, dir.y, dir.x * sinA + dir.z * cosA);

    vec3 tMin = (-hs - lo) / ld;
    vec3 tMax = (hs - lo) / ld;
    vec3 t1 = min(tMin, tMax);
    vec3 t2 = max(tMin, tMax);
    float tNear = max(t1.x, max(t1.y, t1.z));
    float tFar = min(t2.x, min(t2.y, t2.z));
    if (tNear > tFar || tFar < 0.001) return false;

    float t = tNear;
    if (t < 0.001) {
        t = tFar;
        if (t < 0.001) return false;
    }

    vec3 localPos = lo + t * ld;
    vec3 localNormal = vec3(0.0);
    vec3 cd = localPos / hs;
    float ax = abs(cd.x), ay = abs(cd.y), az = abs(cd.z);
    if (ax >= ay && ax >= az)      localNormal = vec3(sign(cd.x), 0.0, 0.0);
    else if (ay >= ax && ay >= az) localNormal = vec3(0.0, sign(cd.y), 0.0);
    else                           localNormal = vec3(0.0, 0.0, sign(cd.z));

    // Transform normal back to world space
    vec3 worldNormal = vec3(
        localNormal.x * cosA + localNormal.z * sinA, localNormal.y,
        -localNormal.x * sinA + localNormal.z * cosA);

    hit.t = t;
    hit.normal = normalize(worldNormal);
    hit.color = obj.color.rgb;
    hit.emissive = 0.0;
    return true;
}

// ============ Scene trace: iterate all SSBO objects ============
bool traceScene(vec3 origin, vec3 dir, int skipIndex, out HitResult hit) {
    hit.t = 1e30;
    hit.emissive = 0.0;
    hit.objIndex = -1;
    bool found = false;

    for (int i = 0; i < scene.objectCount; i++) {
        if (i == skipIndex) continue;

        SceneObject obj = scene.objects[i];
        HitResult r;
        bool hitObj = false;
        int type = int(obj.p0.w);

        if (type == 0) {
            hitObj = intersectPlane(origin, dir, obj, r);
        } else if (type == 1) {
            hitObj = intersectSphere(origin, dir, obj, r);
        } else if (type == 2) {
            hitObj = intersectBox(origin, dir, obj, r);
        }

        if (hitObj && r.t <= hit.t) {
            hit = r;
            hit.objIndex = i;
            found = true;
        }
    }

    return found;
}

float traceShadow(vec3 origin, vec3 dir, float maxT, int skipIndex) {
    for (int i = 0; i < scene.objectCount; i++) {
        if (i == skipIndex) continue;
        SceneObject obj = scene.objects[i];
        HitResult r;
        bool hitObj = false;
        int type = int(obj.p0.w);
        if (type == 0) hitObj = intersectPlane(origin, dir, obj, r);
        else if (type == 1) hitObj = intersectSphere(origin, dir, obj, r);
        else if (type == 2) hitObj = intersectBox(origin, dir, obj, r);
        // Check if anything blocks before the light
        if (hitObj && r.t < maxT - 0.001) return 0.0;
    }
    return 1.0;
}

// ============ Hemisphere sampling ============
vec3 sampleHemisphere(vec3 normal) {
    float u1 = randFloat();
    float u2 = randFloat();

    float r = sqrt(u1);
    float theta = 6.283185307 * u2;

    vec3 tangent = abs(normal.y) < 0.999 ?
                   vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 bitangent = cross(normal, tangent);
    tangent = cross(bitangent, normal);

    vec3 sampleDir = tangent * r * cos(theta) +
                     bitangent * r * sin(theta) +
                     normal * sqrt(1.0 - u1);
    return normalize(sampleDir);
}

// ============ Light sampling (uniform area) ============
vec3 sampleLightPoint(SceneObject obj, out vec3 normal, out float pdf) {
    vec4 bounds = obj.p2; // (umin, vmin, umax, vmax)
    float u = bounds.x + randFloat() * (bounds.z - bounds.x);
    float v = bounds.y + randFloat() * (bounds.w - bounds.y);
    vec3 pt;
    vec3 an = abs(obj.p1.xyz);
    if (an.x > 0.5) {
        pt = vec3(obj.p0.x, u, v);
    } else if (an.y > 0.5) {
        pt = vec3(u, obj.p0.y, v);
    } else {
        pt = vec3(u, v, obj.p0.z);
    }
    normal = obj.p1.xyz;
    float area = (bounds.z - bounds.x) * (bounds.w - bounds.y);
    pdf = 1.0 / area;
    return pt;
}

// ============ Path tracing with NEE ============
vec3 tracePath(vec3 origin, vec3 dir, int lightIndex) {
    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);

    for (int bounce = 0; bounce < ubo.maxBounces; bounce++) {
        HitResult hit;
        if (!traceScene(origin, dir, -1, hit)) break;

        vec3 hitPos = origin + hit.t * dir;

        // Hit emissive surface -> direct camera hit or random walk hit light
        if (hit.emissive > 0.0) {
            // Only add emission on first bounce (direct camera view of light)
            if (bounce == 0) {
                radiance += throughput * hit.color * hit.emissive;
            }
            break; // Emissive surfaces terminate the path
        }

        // NEE: sample light directly (next event estimation)
        if (ubo.enableNEE != 0 && lightIndex >= 0) {
            SceneObject lightObj = scene.objects[lightIndex];
            vec3 lightNormal;
            float lightPdf;
            vec3 lightPt = sampleLightPoint(lightObj, lightNormal, lightPdf);

            vec3 toLight = lightPt - hitPos;
            float distSq = dot(toLight, toLight);
            float dist = sqrt(distSq);
            vec3 lightDir = toLight / dist;

            float cosAtHit  = max(dot(lightDir, hit.normal), 0.0);
            float cosAtLight = max(dot(-lightDir, lightNormal), 0.0);

            if (cosAtHit > 0.0 && cosAtLight > 0.0 && lightPdf > 0.0 && distSq > 0.0001) {
                // Shadow ray: skip the surface we're on (self-intersection)
                float vis = traceShadow(hitPos + 0.001 * hit.normal, lightDir, dist, hit.objIndex);
                if (vis > 0.0) {
                    // Le * (albedo/pi) * G * V / p_area
                    // = Le * hit.color * cosAtHit * cosAtLight * V / (pi * distSq * lightPdf)
                    vec3 direct = throughput
                                * lightObj.color.rgb * lightObj.color.w
                                * hit.color
                                * cosAtHit * cosAtLight
                                * vis
                                / (3.14159265 * distSq * lightPdf);
                    radiance += min(direct, vec3(10.0));
                }
            }
        }

        // BRDF sampling for next bounce (random walk continuation)
        vec3 newDir = sampleHemisphere(hit.normal);
        if (dot(newDir, hit.normal) < 0.0) break;

        throughput *= hit.color;

        // Russian roulette
        if (bounce > 5) {
            float survival = max(max(throughput.r, throughput.g), throughput.b);
            if (randFloat() > survival) break;
            throughput /= survival;
        }

        origin = hitPos + 0.001 * hit.normal;
        dir = newDir;
    }

    return radiance;
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (pix.x >= size.x || pix.y >= size.y) return;

    // ── Stage 1: Verify scene SSBO and light index ──
    int lightIndex = -1;
    for (int i = 0; i < scene.objectCount; i++) {
        if (scene.objects[i].color.w > 0.0) {
            lightIndex = i;
            break;
        }
    }

    // ── Stage 2: Generate camera ray ──
    vec3 camPos = ubo.cameraPos.xyz;
    vec3 camDir = ubo.cameraDir.xyz;
    vec3 camRight = ubo.cameraRight.xyz;
    vec3 camUp = ubo.cameraUp.xyz;

    float tanHalfFov = tan(ubo.fov * 0.5);
    float aspectFactor = tanHalfFov * ubo.aspectRatio;
    float invW = 1.0 / float(size.x);
    float invH = 1.0 / float(size.y);

    randState = wangHash(uint(pix.x + pix.y * size.x) + uint(1u));

    float px = (float(pix.x) + randFloat()) * invW * 2.0 - 1.0;
    float py = -((float(pix.y) + randFloat()) * invH * 2.0 - 1.0);
    px *= aspectFactor;
    py *= tanHalfFov;

    vec3 rayDir = normalize(camDir + px * camRight + py * camUp);

    // ── Stage 3: Trace ray ──
    HitResult hit;
    bool hitSomething = traceScene(camPos, rayDir, -1, hit);

    // ── Direct SSBO read test ──
    // R = scene.objects[5].color.w / 16.0  (should be 10/16 = 0.625)
    // G = scene.objectCount / 16.0         (should be 8/16 = 0.5)
    // B = float(scene.objects[0].p0.x + 1.0) / 2.0 (should be (-1+1)/2 = 0.0)
    float emissive10 = scene.objects[5].color.w;
    float objCount = float(scene.objectCount);
    float p0x = scene.objects[0].p0.x;
    vec3 debugColor = vec3(emissive10 / 16.0, objCount / 16.0, (p0x + 1.0) / 2.0);

    imageStore(outputImage, pix, vec4(debugColor, 1.0));
}
